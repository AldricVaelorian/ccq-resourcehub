# PostgreSQL Configuration
POSTGRES_DB=resourcehub
POSTGRES_USER=resourcehub_user
POSTGRES_PASSWORD=CHANGE_ME_SECRET_PASSWORD

# Spring Boot Application Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/resourcehub
SPRING_DATASOURCE_USERNAME=resourcehub_user
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_SECRET_PASSWORD
SERVER_PORT=8080

# Frontend API URL (for local development)
VITE_API_URL=http://localhost:8080/api