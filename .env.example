# PostgreSQL Database Configuration
POSTGRES_DB=resourcehub
POSTGRES_USER=resourcehub_user
POSTGRES_PASSWORD=resourcehub_pass
POSTGRES_PORT=5432

# Spring Data Source Configuration (override if using custom database settings)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/resourcehub
SPRING_DATASOURCE_USERNAME=resourcehub_user
SPRING_DATASOURCE_PASSWORD=resourcehub_pass

# Application Server Port
SERVER_PORT=8080

# Frontend API URL (for local development)
VITE_API_URL=http://localhost:8080/api
